VAPI_API_KEY="YOUR_VAPI_API_KEY"
DATABASE_URL="sqlite:///data/autopay_voice.db" # Add your database url here (only SQLite supported for now)
BASE_URL="https://autopay.trycloudflare.com" # public origin for pay links, e.g. https://<tunnel>.trycloudflare.com (empty = relative /pay path)
VAPI_PHONE_NUMBER="" # your taken Vapi number (caller id side), e.g. +1-415-555-0100
VAPI_PHONE_NUMBER_ID="" # Vapi phoneNumberId UUID from dashboard (preferred for outbound dial)
TEST_CALL_TO_NUMBER="" # hardcoded test destination you control; wins over per-call input when set