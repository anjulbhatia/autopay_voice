{
  "assistant": {
    "name": "autopay-recovery",
    "server": {
      "url": "http://127.0.0.1:8000/vapi/tool"
    },
    "serverMessages": ["tool-calls", "end-of-call-report"],
    "model": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "messages": [
        {
          "role": "system",
          "content": "ASSEMBLED_AT_CALL_TIME by app/agent.py from agent/prompt.md + policies.md + guardrails.md + tier + customer context. See app/agent.py assemble_prompt."
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "verify_identity",
            "description": "Check the caller's security answer. Call first, max twice.",
            "parameters": {
              "type": "object",
              "properties": { "answer": { "type": "string" } },
              "required": ["answer"]
            }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        },
        {
          "type": "function",
          "function": {
            "name": "get_failed_payment",
            "description": "Failed payment details. Refuses until verify_identity succeeds.",
            "parameters": { "type": "object", "properties": {} }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        },
        {
          "type": "function",
          "function": {
            "name": "send_payment_link",
            "description": "Single-use expiring link to the number on file. Verified callers only.",
            "parameters": {
              "type": "object",
              "properties": { "channel": { "type": "string", "enum": ["console", "whatsapp", "sms"] } }
            }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        },
        {
          "type": "function",
          "function": {
            "name": "schedule_retry",
            "description": "Reminder on a customer-accepted date.",
            "parameters": {
              "type": "object",
              "properties": { "when": { "type": "string" } },
              "required": ["when"]
            }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        },
        {
          "type": "function",
          "function": {
            "name": "request_human_handoff",
            "description": "Queue a human takeover with a reason.",
            "parameters": {
              "type": "object",
              "properties": {
                "reason": { "type": "string" },
                "notes": { "type": "string" }
              },
              "required": ["reason"]
            }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        },
        {
          "type": "function",
          "function": {
            "name": "log_outcome",
            "description": "Close the call with an outcome. Always call this last.",
            "parameters": {
              "type": "object",
              "properties": {
                "result": { "type": "string" },
                "notes": { "type": "string" }
              },
              "required": ["result"]
            }
          },
          "server": { "url": "http://127.0.0.1:8000/vapi/tool" }
        }
      ]
    }
  },
  "notes": "Reference shape for dashboard/CLI import (function tools per docs.vapi.ai/tools/custom-tools, transient assistant per call). Live calls build this in code via app/provider.py build_assistant (vapi-server-sdk), pointed at the local console origin. System prompt is assembled per call, never pasted here."
}
